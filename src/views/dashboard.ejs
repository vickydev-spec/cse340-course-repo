<%- include("partials/header") %>

    <main class="dashboard">

        <h1>
            <%= title %>
        </h1>

        <section class="dashboard-info">

            <h2>Welcome, <%= username %>!</h2>

            <p>
                <strong>Username:</strong>
                <%= username %>
            </p>

            <p>
                <strong>Email:</strong>
                <%= email %>
            </p>

        </section>


        <% if (user && user.role_name==="admin" ) { %>

            <section class="admin-section">

                <h2>Administrator</h2>

                <p>
                    <a href="/users">
                        Manage Users
                    </a>
                </p>

            </section>

            <% } %>


                <!-- ===================================================== -->
                <!-- VOLUNTEER PROJECTS -->
                <!-- ===================================================== -->

                <section class="volunteer-projects">

                    <h2>
                        My Volunteer Projects
                    </h2>


                    <% if ( volunteerProjects && volunteerProjects.length> 0
                        ) { %>

                        <p>
                            You are volunteering for
                            <%= volunteerProjects.length %>
                                project<%= volunteerProjects.length===1 ? "" : "s" %>.
                        </p>


                        <div class="project-list">

                            <% volunteerProjects.forEach(project=> { %>

                                <article class="project-card">

                                    <h3>

                                        <a href="/project/<%= project.project_id %>">

                                            <%= project.title %>

                                        </a>

                                    </h3>


                                    <p>

                                        <strong>
                                            Organization:
                                        </strong>

                                        <a href="/organization/<%= project.organization_id %>">

                                            <%= project.organization_name %>

                                        </a>

                                    </p>


                                    <p>

                                        <strong>
                                            Description:
                                        </strong>

                                        <%= project.description %>

                                    </p>


                                    <p>

                                        <strong>
                                            Location:
                                        </strong>

                                        <%= project.location %>

                                    </p>


                                    <p>

                                        <strong>
                                            Date:
                                        </strong>

                                        <%= project.date %>

                                    </p>


                                    <!-- Remove volunteer -->

                                    <p>

                                        <a href="/project/<%= project.project_id %>/remove-volunteer" class="button">
                                            Remove Me as Volunteer
                                        </a>

                                    </p>

                                </article>

                                <% }) %>

                        </div>


                        <% } else { %>

                            <p>
                                You are not currently volunteering
                                for any projects.
                            </p>

                            <p>

                                <a href="/projects">
                                    Browse Service Projects
                                </a>

                            </p>

                            <% } %>

                </section>

    </main>

    <%- include("partials/footer") %>