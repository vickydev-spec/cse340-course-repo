<%- include("partials/header") %>

<main>

    <h1><%= title %></h1>

    <%
        const messages = flash();
    %>

    <% if (messages.error.length > 0) { %>

        <div class="flash error">

            <ul>

                <% messages.error.forEach(message => { %>

                    <li><%= message %></li>

                <% }) %>

            </ul>

        </div>

    <% } %>

    <% if (messages.success.length > 0) { %>

        <div class="flash success">

            <ul>

                <% messages.success.forEach(message => { %>

                    <li><%= message %></li>

                <% }) %>

            </ul>

        </div>

    <% } %>


    <form action="/new-project" method="POST">

        <div class="form-group">

            <label for="title">

                Project Title

            </label>

            <input
                type="text"
                id="title"
                name="title"
                maxlength="150"
                required
                value="<%= formData?.title || '' %>"
            >

        </div>


        <div class="form-group">

            <label for="description">

                Description

            </label>

            <textarea
                id="description"
                name="description"
                maxlength="500"
                required
            ><%= formData?.description || '' %></textarea>

        </div>


        <div class="form-group">

            <label for="location">

                Location

            </label>

            <input
                type="text"
                id="location"
                name="location"
                maxlength="255"
                required
                value="<%= formData?.location || '' %>"
            >

        </div>


        <div class="form-group">

            <label for="date">

                Date

            </label>

            <input
                type="date"
                id="date"
                name="date"
                required
                value="<%= formData?.date || '' %>"
            >

        </div>


        <div class="form-group">

            <label for="organizationId">

                Organization

            </label>

            <select
                id="organizationId"
                name="organizationId"
                required
            >

                <option value="">

                    Select an organization

                </option>

                <% organizations.forEach(org => { %>

                    <option
                        value="<%= org.organization_id %>"
                        <%= formData?.organizationId == org.organization_id ? "selected" : "" %>
                    >

                        <%= org.name %>

                    </option>

                <% }) %>

            </select>

        </div>


        <button type="submit">

            Create Project

        </button>

    </form>

</main>

<%- include("partials/footer") %>