<%- include("partials/header") %>

    <main class="project-details">

        <!-- =====================================================
         PROJECT TITLE
    ====================================================== -->

        <h1>
            <%= project.title %>
        </h1>


        <!-- =====================================================
         ORGANIZATION
    ====================================================== -->

        <p>
            <strong>Organization:</strong>

            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>


        <!-- =====================================================
         DESCRIPTION
    ====================================================== -->

        <p>
            <strong>Description:</strong>

            <%= project.description %>
        </p>


        <!-- =====================================================
         LOCATION
    ====================================================== -->

        <p>
            <strong>Location:</strong>

            <%= project.location %>
        </p>


        <!-- =====================================================
         PROJECT DATE
    ====================================================== -->

        <p>
            <strong>Date:</strong>

            <%= project.date %>
        </p>


        <!-- =====================================================
         CATEGORIES
    ====================================================== -->

        <% if (categories && categories.length> 0) { %>

            <h2>Categories</h2>

            <ul>

                <% categories.forEach(category=> { %>

                    <li>
                        <%= category.name %>
                    </li>

                    <% }) %>

            </ul>

            <% } %>


                <!-- =====================================================
         WEEK 6 VOLUNTEER FUNCTIONALITY
    ====================================================== -->

                <% if (user) { %>

                    <section class="volunteer-section">

                        <h2>Volunteer</h2>


                        <% if (volunteerStatus) { %>

                            <!-- User is already volunteering -->

                            <p>
                                You are volunteering for this project.
                            </p>

                            <a href="/project/<%= project.project_id %>/remove-volunteer" class="button">
                                Remove Me as a Volunteer
                            </a>


                            <% } else { %>

                                <!-- User has not volunteered yet -->

                                <p>
                                    Interested in helping with this project?
                                </p>

                                <a href="/project/<%= project.project_id %>/volunteer" class="button">
                                    Volunteer for This Project
                                </a>

                                <% } %>

                    </section>

                    <% } %>


                        <!-- =====================================================
         BACK TO PROJECTS
    ====================================================== -->

                        <p>
                            <a href="/projects">
                                ← Back to Projects
                            </a>
                        </p>

    </main>

    <%- include("partials/footer") %>