<%- include("partials/header") %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= project.date %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>

            <strong>Organization:</strong>

            <a href="/organization/<%= project.organization_id %>">

                <%= project.organization_name %>

            </a>

        </p>

        <h2>
            Categories
        </h2>

        <div class="category-tags">

            <% categories.forEach(category=> { %>

                <a href="/category/<%= category.category_id %>">

                    <%= category.name %>

                </a>

                <% }); %>

        </div>

        <% if (user && user.role_name==="admin" ) { %>

            <p>

                <a href="/project/<%= project.project_id %>/assign-categories">

                    Edit Categories

                </a>

            </p>

            <p>

                <a href="/edit-project/<%= project.project_id %>">

                    Edit Project

                </a>

            </p>

            <% } %>

    </main>

    <%- include("partials/footer") %>