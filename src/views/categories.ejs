<%- include("partials/header") %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <% if (user && user.role_name==="admin" ) { %>

            <p>

                <a href="/new-category">

                    Create New Category

                </a>

            </p>

            <% } %>

                <ul>

                    <% categories.forEach(category=> { %>

                        <li>

                            <a href="/category/<%= category.category_id %>">

                                <%= category.name %>

                            </a>

                            <% if (user && user.role_name==="admin" ) { %>

                                |

                                <a href="/edit-category/<%= category.category_id %>">

                                    Edit

                                </a>

                                <% } %>

                        </li>

                        <% }); %>

                </ul>

    </main>

    <%- include("partials/footer") %>